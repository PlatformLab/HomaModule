    curves = []
    for spec in specs:
        curves.append(["%s_%s" % (spec['exp_name'], workload),
                        spec['label'] + ' P99',
                        spec['colors'][1] if 'colors' in spec else None,
                        "p99"])
    for spec in specs:
        curves.append(["%s_%s" % (spec['exp_name'], workload),
                        spec['label'] + ' P50',
                        spec['colors'][0] if 'colors' in spec else None,
                        "p50"])
    plots.append(["slowdown", "%s/reports/%s_%s_slow.pdf" %
            (options.log_dir, options.config, workload), curves])
    plots.append(["rtt", "%s/reports/%s_%s_rtt.pdf" %
            (options.log_dir, options.config, workload), curves])
    curves = []
    for spec in specs:
        curves.append(["%s_%s" % (spec['exp_name'], workload),
                        spec['label'],
                        spec['colors'][1] if 'colors' in spec else None])
    plots.append(["short_cdf", "%s/reports/%s_%s_cdfs.pdf" %
            (options.log_dir, options.config, workload), curves])

for plot in plots:
    type = plot[0]
    if type == 'rtt':
        log("Generating rtt latency plot for %s" % (workload))
        file, curves = plot[1:3]
        title = "%s, %d %s nodes, %.1f Gbps" % (workload.capitalize(),
                options.num_nodes, get_node_type(), bw)
        ax = start_plot_vs_msg_length(title, [10, 10000], curves[0][0],
                y_label=r'RTT (µsec)')
        for exp, label, color, p in curves:
            plot_histogram(ax, exp, p, label, color=color)
        ax.legend(loc="upper left", prop={'size': 9})
        plt.tight_layout()
        plt.savefig(file)
    elif type == 'slowdown':
        log("Generating slowdown plot for %s" % (workload))
        file, curves = plot[1:3]
        title = "%s, %d %s nodes, %.1f Gbps" % (workload.capitalize(),
                options.num_nodes, get_node_type(), bw)
        ax = start_plot_vs_msg_length(title, plot_max_y, curves[0][0],
                y_label=" Slowdown")
        for exp, label, color, p in curves:
            plot_slowdown(ax, exp, p, label, color=color)
        if workload == "w5":
            ax.legend(loc="upper right", prop={'size': 9})
        else:
            ax.legend(loc="upper left", prop={'size': 9})
        plt.tight_layout()
        plt.savefig(file)
    elif type == 'short_cdf':
        log("Generating short message CDFs for %s" % (workload))
        file, curves = plot[1:3]
        title = "%s, %d %s nodes" % (workload.capitalize(), options.num_nodes,
                get_node_type())
        start_cdf_plot(title, 10, 0.99e05, 1e-05, "RTT (usecs)",
                "Cumulative Fraction of Short Messages")
        for exp, label, color in curves:
            x, y = get_short_cdf(exp)
            plt.plot(x, y, label=label, color=color)
        plt.legend(loc="upper right", prop={'size': 9})
        plt.savefig(file)
